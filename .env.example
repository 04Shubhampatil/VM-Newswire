APP_NAME="VM Newswire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Error tracking (optional): https://sentry.io project DSN. Empty = disabled.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# MySQL 8+ (use DB_CONNECTION=sqlite for a quick local start without MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vm_newswire
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set true so session cookies are only sent over TLS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Enquiry emails are queued: run `php artisan queue:work` (or `php artisan dev` locally)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes emails to storage/logs/laravel.log.
# Production: use SMTP from a transactional provider (Postmark, SendGrid, Amazon SES, ...).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sales@vmnewswire.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sample report PDFs and media logos. Set SAMPLE_REPORTS_DISK=s3 (and fill the AWS_* values) for S3-compatible storage.
SAMPLE_REPORTS_DISK=local
SAMPLE_REPORT_MAX_KB=10240
MEDIA_LOGOS_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- VM Newswire ---
# First admin (created by `php artisan db:seed`). Leave ADMIN_PASSWORD empty to
# generate a one-time password that must be changed at first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where new-enquiry notifications go (can also be changed in Admin → Settings)
ADMIN_NOTIFICATION_EMAIL=sales@vmnewswire.com
# Seed demo packages/outlets in production (normally false)
SEED_DEMO_DATA=false
# Enquiry form rate limits per IP
ENQUIRY_RATE_PER_MINUTE=3
ENQUIRY_RATE_PER_DAY=20
# Optional integrations — leave empty to disable
GA4_MEASUREMENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
